# --- Majburiy ---
# Bot bilan BIR XIL baza fayli
DB_PATH=/opt/tanga/tanga.db

# Sessiya cookie'sini imzolash kaliti (kamida 32 belgi).
# Yaratish:  python manage.py kalit
ADMIN_SECRET_KEY=

# Foydalanuvchiga xabar yuborish uchun (bot bilan bir xil token)
