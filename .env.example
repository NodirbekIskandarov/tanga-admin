# --- Ixtiyoriy ---
COOKIE_SECURE=true
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TIMEZONE=Asia/Tashkent
# Foyda hisobi uchun dollar kursi
USD_RATE=12600
APP_NAME=Tanga — Admin
