[Unit]
Description=Tanga admin boshqaruv paneli
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tanga
Group=tanga
WorkingDirectory=/opt/tanga-admin
EnvironmentFile=/opt/tanga-admin/.env
# Caddy Docker konteynerida ishlaydi, shuning uchun 127.0.0.1 emas, docker
# ko'prigining host manzili. Bu manzil tashqi tarmoqdan yo'naltirilmaydi.
ExecStart=/opt/tanga-admin/.venv/bin/uvicorn app:app --host 172.30.0.1 --port 8100 --proxy-headers --forwarded-allow-ips *
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

# Xavfsizlik cheklovlari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Bot bazasi va o'z katalogi — yozish faqat shu ikkisiga
ReadWritePaths=/opt/tanga-admin /opt/tanga

[Install]
WantedBy=multi-user.target
